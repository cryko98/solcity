# Sol City reward server settings. Copy to server/.env and fill in.
# server/.env is in .gitignore: never commit it, never paste it anywhere.

# ---- web server
PORT=8080
HOST=127.0.0.1
# behind nginx / Caddy / Cloudflare: take the player's IP from X-Forwarded-For
# (the last entry, the one your proxy adds)
TRUST_PROXY=true
# your site's name, shown in the wallet sign-in message
PUBLIC_DOMAIN=

# ---- secrets
# 32+ random characters, e.g. the output of:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# the HOT wallet that pays rewards (base58 secret key, or the JSON array from solana-keygen).
# Keep only a few days' worth of DaCity in it and refill it by hand; never the main treasury.
TREASURY_SECRET_KEY=

# ---- Solana
# a private RPC (Helius, QuickNode, Triton...) is strongly recommended over the public one
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# the DaCity token's mint address
DACITY_MINT=nxPqZ4F7ux8Vph5NFu25rEP6Kx9Gr1U6Fmj36Rjpump
# true = nothing is sent, rewards are only recorded. Switch to false when everything is checked.
DRY_RUN=true

# ---- rewards, in whole DaCity
# per story mission, paid once per wallet (15 missions incl. the bank job, 485 in total with these numbers)
# STORY_REWARDS={"rosa1":10,"rosa2":12,"vince1":15,"vince2":18,"diaz1":20,"diaz2":22,"rosa3":25,"vince3":28,"diaz3":30,"zara1":35,"zara2":40,"zara3":60,"zara4":30,"zara5":40,"zara6":100}
# per finished street race (gold pays double), up to RACE_DAILY_PER_RACE times per race per day
RACE_REWARD=3
RACE_DAILY_PER_RACE=2
RACE_COOLDOWN_SEC=240

# ---- limits that protect the pot
WALLET_DAILY_CAP=120
WALLET_LIFETIME_CAP=2000
GLOBAL_DAILY_BUDGET=5000
# Only $SOLCITY holders earn DaCity: a wallet must hold at least MIN_HOLDING of the token at SOLCITY_MINT.
# Everybody else plays for in-game dollars only. Fill in SOLCITY_MINT at launch (required to go live).
SOLCITY_MINT=
MIN_HOLDING=10000
# The game itself is for those holders too (at least MIN_HOLDING): without such a wallet a player gets
# 5 minutes of free play, then has to connect one. Multiplayer always needs it, and a username.
HOLDERS_ONLY=true
MAX_WALLETS_PER_IP_PER_DAY=3
MAX_RUN_STARTS_PER_HOUR=30

# ---- the pot (what the payout wallet has ever received = its balance + what it paid out)
# up to POT_FULL_UNTIL tokens all of it can be earned; of anything above, POT_SHARE_AFTER (0-1).
# 0 = no pot rule: only the caps above and the wallet's balance limit payouts.
POT_FULL_UNTIL=0
POT_SHARE_AFTER=0.5

# ---- payouts
PAYOUT_INTERVAL_SEC=60
PAYOUT_BATCH=10
# a new wallet is first paid once it has earned this much (each new wallet costs ~0.002 SOL rent)
MIN_PAYOUT=20

# ---- optional: Cloudflare Turnstile bot check at wallet sign-in
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
